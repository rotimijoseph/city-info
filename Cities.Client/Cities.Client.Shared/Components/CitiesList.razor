@using System.Net.Http.Json
@inject HttpClient Http

@page "/cities"

<h3>Explore Cities</h3>

@if (cities == null)
{
    <p>Loading cities...</p>
}
else if (cities.Count == 0)
{
    <p>No cities found.</p>
}
else
{
    @foreach (var city in cities)
    {
        <div class="city-card">
            <h4>@city.Name</h4>
            <p>@city.Description</p>
            <p>City ID: @city.Id</p>

            <h5>Points of Interest</h5>

            <div class="city-poi-section">
                <div class="city-poi-heading">
                    <h5>Places to explore</h5>
                    <span class="count-pill">
                        @city.PointsOfInterest.Count places
                    </span>
                </div>

                @if (city.PointsOfInterest.Count == 0)
                {
                    <p class="empty-message">
                        No places added to this city yet.
                    </p>
                }
                else
                {
                    <div class="city-poi-list">
                        @foreach (var point in city.PointsOfInterest)
                        {
                            <div class="city-poi-item" @key="point.Id">
                                <div class="city-poi-icon">⌖</div>

                                <div class="city-poi-info">
                                    <h6>@point.Name</h6>

                                    @if (!string.IsNullOrWhiteSpace(point.Description))
                                    {
                                        <p>@point.Description</p>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
            <a href="@($"cities/{city.Id}")" class="btn btn-green">
                View City →
            </a>
        </div>
    }
}

@code {
    private List<City>? cities;

    protected override async Task OnInitializedAsync()
    {
        cities = await Http.GetFromJsonAsync<List<City>>("api/cities");
    }

    public class City
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public List<PointOfInterest> PointsOfInterest { get; set; } = new();
    }

    public class PointOfInterest
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string? Description { get; set; }
    }
}